+# (`game::remote`), which are not part of the stable hook points.
+[compatibility]
+horizon_revision = "c9d474dd9116e84c243f8992d75c11314df56f06"
+
+# Simple Voice Chat's protocol, Opus, the sound card and the voice threads.
+[[crate]]
+id = "engine"
