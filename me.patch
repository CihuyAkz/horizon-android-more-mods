index 0000000..a5dd956
--- /dev/null
+++ b/native-mods/voicechat/mixins/voicechat/engine/src/crypt.rs
@@ -0,0 +1,86 @@
+//! `Secret.encrypt` / `decrypt`: AES-128-GCM with a random 12 byte IV in
+//! front of the ciphertext and its 16 byte tag.
+use ring::aead::{AES_128_GCM, Aad, LessSafeKey, NONCE_LEN, Nonce, UnboundKey};
+use ring::rand::{SecureRandom, SystemRandom};
+
+pub struct Crypt {
+    key: LessSafeKey,
+    rng: SystemRandom,
+}
+
+impl Crypt {
+    pub fn new(secret: &[u8; 16]) -> Self {
+        let key = UnboundKey::new(&AES_128_GCM, secret).expect("16 byte AES key");
+        Self { key: LessSafeKey::new(key), rng: SystemRandom::new() }
+    }
+
+    pub fn encrypt(&self, plain: &[u8]) -> Vec<u8> {
+        let mut iv = [0u8; NONCE_LEN];
+        self.rng.fill(&mut iv).expect("system randomness");
+        let mut out = Vec::with_capacity(NONCE_LEN + plain.len() + 16);
+        out.extend_from_slice(&iv);
+        let mut body = plain.to_vec();
+        self.key
+            .seal_in_place_append_tag(Nonce::assume_unique_for_key(iv), Aad::empty(), &mut body)
+            .expect("sealing a packet");
+        out.extend_from_slice(&body);
+        out
+    }
+
+    /// None for a packet that wasn't sealed with this secret.
+    pub fn decrypt(&self, payload: &[u8]) -> Option<Vec<u8>> {
+        if payload.len() < NONCE_LEN + 16 {
+            return None;
+        }
+        let iv: [u8; NONCE_LEN] = payload[..NONCE_LEN].try_into().ok()?;
+        let mut body = payload[NONCE_LEN..].to_vec();
+        let plain = self
+            .key
+            .open_in_place(Nonce::assume_unique_for_key(iv), Aad::empty(), &mut body)
+            .ok()?;
+        Some(plain.to_vec())
+    }
+}
+
+pub fn random_uuid() -> u128 {
+    let mut b = [0u8; 16];
+    SystemRandom::new().fill(&mut b).expect("system randomness");
+    u128::from_be_bytes(b)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trips_and_rejects_other_keys() {
+        let a = Crypt::new(&[7; 16]);
+        let sealed = a.encrypt(b"hello voice");
+        assert_eq!(sealed.len(), 12 + 11 + 16);
+        assert_eq!(a.decrypt(&sealed).unwrap(), b"hello voice");
+        assert!(Crypt::new(&[8; 16]).decrypt(&sealed).is_none());
+    }
+
+    /// NIST GCM test case 3 (AES-128, 96 bit IV): Java's
+    /// `AES/GCM/NoPadding` gives the same bytes.
+    #[test]
+    fn matches_the_gcm_test_vector() {
+        let key: [u8; 16] = hex("feffe9928665731c6d6a8f9467308308").try_into().unwrap();
+        let iv = hex("cafebabefacedbaddecaf888");
+        let pt = hex(concat!(
+            "d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a72",
+            "1c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"
+        ));
+        let ct = hex(concat!(
+            "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e",
+            "21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f5985",
+            "4d5c2af327cd64a62cf35abd2ba6fab4"
+        ));
+        let payload = [iv, ct].concat();
+        assert_eq!(Crypt::new(&key).decrypt(&payload).unwrap(), pt);
+    }
+
+    fn hex(s: &str) -> Vec<u8> {
+        (0..s.len()).step_by(2).map(|i| u8::from_str_radix(&s[i..i + 2], 16).unwrap()).collect()
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/labels.rs b/native-mods/voicechat/mixins/voicechat/engine/src/labels.rs
new file mode 100644
index 0000000..4d4d201
--- /dev/null
+++ b/native-mods/voicechat/mixins/voicechat/engine/src/labels.rs
@@ -0,0 +1,114 @@
+//! Labels above players in the world: which voice chat group each is in, as
+//! the camera the last frame drew from sees them. The projection is the
+//! waypoints mod's.
+
+/// The camera: its position, yaw and pitch in degrees, vertical field of view.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Camera {
+    pub pos: [f64; 3],
+    pub yaw: f32,
+    pub pitch: f32,
+    pub fov: f32,
+}
+
+fn sub(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[0] - b[0], a[1] - b[1], a[2] - b[2]]
+}
+
+fn dot(a: [f64; 3], b: [f64; 3]) -> f64 {
+    a[0] * b[0] + a[1] * b[1] + a[2] * b[2]
+}
+
+fn cross(a: [f64; 3], b: [f64; 3]) -> [f64; 3] {
+    [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]
+}
+
+/// `Entity.calculateViewVector`: 0 yaw faces south, positive pitch down.
+fn forward(yaw: f32, pitch: f32) -> [f64; 3] {
+    let (y, p) = (f64::from(yaw).to_radians(), f64::from(pitch).to_radians());
+    [-y.sin() * p.cos(), -p.sin(), y.cos() * p.cos()]
+}
+
+/// The camera's forward, right and up. Right comes from the yaw alone, so
+/// looking straight up or down still has one.
+fn basis(yaw: f32, pitch: f32) -> ([f64; 3], [f64; 3], [f64; 3]) {
+    let f = forward(yaw, pitch);
+    let y = f64::from(yaw).to_radians();
+    let r = [-y.cos(), 0.0, -y.sin()];
+    (f, r, cross(r, f))
+}
+
+/// `point` on a `size` screen, as the world's perspective projection draws
+/// it; None behind the camera.
+pub fn project(camera: &Camera, point: [f64; 3], size: [f32; 2]) -> Option<[f32; 2]> {
+    let (f, r, u) = basis(camera.yaw, camera.pitch);
+    let d = sub(point, camera.pos);
+    let z = dot(d, f);
+    if z < 0.05 || size[1] <= 0.0 {
+        return None;
+    }
+    let t = (f64::from(camera.fov).to_radians() / 2.0).tan();
+    let aspect = f64::from(size[0]) / f64::from(size[1]);
+    let nx = dot(d, r) / (z * t * aspect);
+    let ny = dot(d, u) / (z * t);
+    Some([((nx + 1.0) / 2.0 * f64::from(size[0])) as f32, ((1.0 - ny) / 2.0 * f64::from(size[1])) as f32])
+}
+
+/// Labels show for players this close.
+pub const RANGE: f64 = 64.0;
+/// Above the eyes, clear of the name tag.
+const ABOVE_EYES: f64 = 0.95;
+
+/// A label's text centred at `at` (GUI pixels), in `rgb`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Label {
+    pub text: String,
+    pub at: [f32; 2],
+    pub rgb: u32,
+}
+
+/// The labels for `players` (eye position, group name, whether it is the
+/// player's own group), the farthest first so the nearest draws on top.
+pub fn place(camera: &Camera, size: [f32; 2], players: &[([f64; 3], String, bool)]) -> Vec<Label> {
+    let mut placed: Vec<(f64, Label)> = players
+        .iter()
+        .filter_map(|(eye, group, ours)| {
+            let point = [eye[0], eye[1] + ABOVE_EYES, eye[2]];
+            let d = sub(point, camera.pos);
+            let distance = dot(d, d).sqrt();
+            if distance > RANGE {
+                return None;
+            }
+            let at = project(camera, point, size)?;
+            let on_screen = (0.0..=size[0]).contains(&at[0]) && (0.0..=size[1]).contains(&at[1]);
+            on_screen.then(|| {
+                (distance, Label { text: format!("[{group}]"), at, rgb: if *ours { 0x55FF55 } else { 0xFFFF55 } })
+            })
+        })
+        .collect();
+    placed.sort_by(|a, b| b.0.total_cmp(&a.0));
+    placed.into_iter().map(|(_, l)| l).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_player_ahead_gets_a_label_above_the_middle() {
+        let camera = Camera { pos: [0.0, 65.62, 0.0], yaw: 0.0, pitch: 0.0, fov: 70.0 };
+        let size = [400.0, 200.0];
+        let players = vec![
+            ([0.0, 65.62, 10.0], "Builders".to_owned(), false),
+            ([0.0, 65.62, 5.0], "Mine".to_owned(), true),
+            ([0.0, 65.62, -10.0], "Behind".to_owned(), false),
+            ([0.0, 65.62, 100.0], "Far".to_owned(), false),
+        ];
+        let labels = place(&camera, size, &players);
+        assert_eq!(labels.len(), 2);
+        // The farther one first, the nearer drawn over it.
+        assert_eq!(labels[0].text, "[Builders]");
+        assert_eq!((labels[1].text.as_str(), labels[1].rgb), ("[Mine]", 0x55FF55));
+        assert!((labels[0].at[0] - 200.0).abs() < 0.01 && labels[0].at[1] < 100.0);
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/lib.rs b/native-mods/voicechat/mixins/voicechat/engine/src/lib.rs
