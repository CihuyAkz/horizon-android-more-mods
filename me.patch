+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn world(address: &str) -> World<'_> {
+        World { address, listener: None, players: Vec::new(), redirect: |h, p| (h.to_owned(), p) }
+    }
+
+    /// The tests share the one voice chat.
+    static SERIAL: Mutex<()> = Mutex::new(());
+
+    #[test]
+    fn asks_for_the_secret_with_both_versions() {
+        let _serial = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+        let none = |_: &str| None;
+        let t = tick(Some(world("play.example.net")), &none);
+        assert_eq!(t.payloads[0].0, "minecraft:register");
+        assert!(t.payloads.iter().all(|(c, _)| c != "voicechat:request_secret"));
+        voice().session.as_mut().unwrap().next_ask = Instant::now();
+        let t = tick(Some(world("play.example.net")), &none);
+        assert_eq!(t.payloads, vec![("voicechat:request_secret".into(), 20i32.to_be_bytes().to_vec())]);
+        voice().session.as_mut().unwrap().next_ask = Instant::now();
+        let t = tick(Some(world("play.example.net")), &none);
+        assert_eq!(t.payloads[0].1, 21i32.to_be_bytes().to_vec());
+        assert!(!payload("minecraft:brand", b""));
+        let t = tick(None, &none);
+        assert!(t.payloads.is_empty());
+        assert!(voice().session.is_none());
+    }
+
+    #[test]
+    fn shows_other_players_groups() {
+        use buf::Writer;
+        let _serial = SERIAL.lock().unwrap_or_else(|e| e.into_inner());
+        let none = |_: &str| None;
+        tick(None, &none);
+        let mut w = world("groups.example.net");
+        w.players = vec![(0xA, [0.0, 65.62, 10.0]), (0xB, [3.0, 65.62, 12.0])];
+        tick(Some(w), &none);
+        // As a 2.6 server sends them: a secret, the groups, then the states.
+        let mut secret = Writer::new();
+        secret.raw(&[1; 16]).i32(24454).uuid(0xC).u8(0).i32(1275);
+        secret.raw(&48f64.to_be_bytes()).i32(1000).bool(true).utf("127.0.0.1").bool(false);
+        {
+            let mut v = voice();
+            let s = v.session.as_mut().unwrap();
+            s.secret = Some(Secret::parse(&secret.finish()).unwrap());
+        }
+        for (id, name) in [(0x61u128, "Builders"), (0x62, "Miners")] {
+            let mut g = Writer::new();
+            g.uuid(id).utf(name).bool(false).bool(true).bool(false).i16(0);
+            assert!(payload("voicechat:add_group", &g.finish()));
+        }
+        let mut states = Writer::new();
+        states.i32(3);
+        for (id, name, group) in [(0xAu128, "Alex", 0x61u128), (0xB, "Bea", 0x62), (0xC, "Me", 0x61)] {
+            states.bool(false).bool(false).uuid(id).utf(name).bool(true).uuid(group);
+        }
+        assert!(payload("voicechat:states", &states.finish()));
+        let mut joined = Writer::new();
+        joined.bool(true).uuid(0x61).bool(false);
+        payload("voicechat:joined_group", &joined.finish());
+
+        let camera = labels::Camera { pos: [0.0, 65.62, 0.0], yaw: 0.0, pitch: 0.0, fov: 70.0 };
+        let shown = group_labels(&camera, [400.0, 200.0]);
+        let texts: Vec<_> = shown.iter().map(|l| (l.text.as_str(), l.rgb)).collect();
+        assert_eq!(texts, vec![("[Miners]", 0xFFFF55), ("[Builders]", 0x55FF55)]);
+        let list = command("vc groups").unwrap();
+        assert_eq!(list, vec!["Builders (yours): Alex, Me", "Miners: Bea"]);
+        let hud: Vec<String> = hud("key.keyboard.v").into_iter().map(|l| l.text).collect();
+        assert!(hud.contains(&"Group: Builders".to_owned()) && hud.contains(&"  with Alex".to_owned()), "{hud:?}");
+
+        // The menu: a password group asks for its password, then joins.
+        {
+            let mut v = voice();
+            let s = v.session.as_mut().unwrap();
+            s.groups.get_mut(&0x62).unwrap().has_password = true;
+        }
+        *voice().shared.status.lock().unwrap() = Status::Connected;
+        menu_open(Some('v'));
+        let measure = |t: &str| t.len() as f32 * 6.0;
+        let keys = vec![("Push to talk".to_owned(), key_label(DEFAULT_PTT))];
+        let draws = menu_draw([480.0, 270.0], [0.0, 0.0], &measure, keys.clone());
+        let has = |d: &[ui::Draw], want: &str| d.iter().any(|d| matches!(d, ui::Draw::Text(t, ..) if t == want));
+        assert!(has(&draws, "Caps Lock") && has(&draws, "Miners (password)") && has(&draws, "Alex, Me"));
+        let join = voice().menu.hit_rect(&ui::Action::Join(0x62)).unwrap();
+        tick(Some(world("groups.example.net")), &none);
+        menu_click([join[0] + 1.0, join[1] + 1.0]);
+        assert_eq!(voice().menu.joining, Some(0x62));
+        menu_char('v');
+        for c in "hunter2".chars() {
+            menu_char(c);
+        }
+        menu_key("key.keyboard.enter", false, DEFAULT_MENU);
+        let t = tick(Some(world("groups.example.net")), &none);
+        assert_eq!(t.payloads, vec![proto::join_group(0x62, Some("hunter2"))].into_iter().map(|(c, d)| (c.to_owned(), d)).collect::<Vec<_>>());
+        menu_key(DEFAULT_MENU, false, DEFAULT_MENU);
+        assert!(menu_take_close() && !menu_is_open());
+        tick(None, &none);
+    }
+
+    #[test]
+    fn settings_round_trip_and_cycle() {
+        let mut s = Settings::default();
+        s.click(0);
+        s.click(3);
+        s.click(6);
+        let stored: HashMap<_, _> = s.stored().into_iter().collect();
+        let back = Settings::load(&|k| stored.get(k).cloned());
+        assert_eq!(back, s);
+        assert_eq!((back.mode, back.volume, back.protocol), (Mode::Voice, 125, Protocol::V26));
+        assert_eq!(key_label("key.keyboard.caps.lock"), "Caps Lock");
+        assert_eq!(compat_key("Play.Example.net:25565"), "compat.play.example.net_25565");
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/mix.rs b/native-mods/voicechat/mixins/voicechat/engine/src/mix.rs
new file mode 100644
index 0000000..dfcbb59
--- /dev/null
+++ b/native-mods/voicechat/mixins/voicechat/engine/src/mix.rs
@@ -0,0 +1,223 @@
+//! Voices to the speakers: each channel's decoded frames wait in a short
+//! buffer, then play mixed at 48 kHz, panned and faded by distance as
+//! Simple Voice Chat's OpenAL sources are (linear distance model, reference
+//! distance 0).
+use crate::opus::FRAME;
+use std::collections::{HashMap, VecDeque};
+
+/// Frames a voice holds back before it plays: 60 ms against jitter.
+const PREBUFFER: usize = 3;
+/// More than this waiting means the voice fell behind: drop the oldest.
+const MAX_QUEUED: usize = 16;
+
+/// One 20 ms mono frame with its left and right gains.
+pub struct Frame {
+    pub pcm: Vec<f32>,
+    pub gain: [f32; 2],
+}
+
+#[derive(Default)]
+struct Voice {
+    frames: VecDeque<Frame>,
+    playing: bool,
+    /// The sender stopped: play out what is left without waiting.
+    ended: bool,
+}
+
+#[derive(Default)]
+pub struct Mixer {
+    voices: HashMap<u128, Voice>,
+    /// Mixed 48 kHz stereo not yet played.
+    out: VecDeque<[f32; 2]>,
+    /// The resampler: the last two source samples and the position between.
+    prev: [f32; 2],
+    next: [f32; 2],
+    phase: f64,
+}
+
+impl Mixer {
+    pub fn push(&mut self, channel: u128, frame: Frame) {
+        let v = self.voices.entry(channel).or_default();
+        v.ended = false;
+        v.frames.push_back(frame);
+        while v.frames.len() > MAX_QUEUED {
+            v.frames.pop_front();
+        }
+    }
+
+    pub fn end(&mut self, channel: u128) {
+        if let Some(v) = self.voices.get_mut(&channel) {
+            v.ended = true;
+        }
+    }
+
+    pub fn clear(&mut self) {
+        self.voices.clear();
+        self.out.clear();
+    }
+
+    /// Mixes the next 20 ms of every voice that is ready.
+    fn render(&mut self) {
+        let mut block = vec![[0f32; 2]; FRAME];
+        self.voices.retain(|_, v| {
+            if !v.playing && (v.frames.len() >= PREBUFFER || (v.ended && !v.frames.is_empty())) {
+                v.playing = true;
+            }
+            if v.playing {
+                match v.frames.pop_front() {
+                    Some(f) => {
+                        for (o, s) in block.iter_mut().zip(&f.pcm) {
+                            o[0] += s * f.gain[0];
+                            o[1] += s * f.gain[1];
+                        }
+                    }
+                    // Ran dry: wait for the buffer to fill again.
+                    None => v.playing = false,
+                }
+            }
+            !(v.ended && v.frames.is_empty())
+        });
+        self.out.extend(block.into_iter().map(|[l, r]| [soft_clip(l), soft_clip(r)]));
+    }
+
+    fn source(&mut self) -> [f32; 2] {
+        if self.out.is_empty() {
+            self.render();
+        }
+        self.out.pop_front().unwrap_or_default()
+    }
+
+    /// The next stereo sample at the device's `rate`.
+    pub fn sample(&mut self, rate: u32) -> [f32; 2] {
+        if rate == crate::opus::SAMPLE_RATE {
+            return self.source();
+        }
+        self.phase += f64::from(crate::opus::SAMPLE_RATE) / f64::from(rate);
+        while self.phase >= 1.0 {
+            self.phase -= 1.0;
+            self.prev = self.next;
+            self.next = self.source();
+        }
+        let t = self.phase as f32;
+        [self.prev[0] + (self.next[0] - self.prev[0]) * t, self.prev[1] + (self.next[1] - self.prev[1]) * t]
+    }
+
+    pub fn voices(&self) -> usize {
+        self.voices.len()
+    }
+}
+
+fn soft_clip(x: f32) -> f32 {
+    if x.abs() <= 0.9 { x } else { x.signum() * (0.9 + (x.abs() - 0.9).tanh() * 0.1) }
+}
+
+/// Converts any rate to 48 kHz, for the microphone.
+pub struct Resampler {
+    rate: u32,
+    phase: f64,
+    prev: f32,
+}
+
+impl Resampler {
+    pub fn new(rate: u32) -> Self {
+        Self { rate, phase: 0.0, prev: 0.0 }
+    }
+
+    pub fn push(&mut self, sample: f32, out: &mut impl Extend<f32>) {
+        if self.rate == crate::opus::SAMPLE_RATE {
+            out.extend([sample]);
+            return;
+        }
+        let step = f64::from(self.rate) / f64::from(crate::opus::SAMPLE_RATE);
+        while self.phase < 1.0 {
+            let t = self.phase as f32;
+            out.extend([self.prev + (sample - self.prev) * t]);
+            self.phase += step;
+        }
+        self.phase -= 1.0;
+        self.prev = sample;
+    }
+}
+
+/// Where the player hears from: the eyes and the way they look.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Listener {
+    pub eye: [f64; 3],
+    /// Degrees; 0 faces south (+Z), 90 west.
+    pub yaw: f32,
+}
+
+/// Left and right gains for a voice at `at`, heard up to `max_distance`:
+/// none past it, full at the listener, linear between, and panned with equal
+/// power by the side it comes from. None when out of reach.
+pub fn spatial(listener: &Listener, at: [f64; 3], max_distance: f32) -> Option<[f32; 2]> {
+    let d = [at[0] - listener.eye[0], at[1] - listener.eye[1], at[2] - listener.eye[2]];
+    let distance = (d[0] * d[0] + d[1] * d[1] + d[2] * d[2]).sqrt() as f32;
+    if distance > max_distance + 1.0 {
+        return None;
+    }
+    let gain = (1.0 - distance / max_distance.max(0.001)).clamp(0.0, 1.0);
+    let yaw = listener.yaw.to_radians();
+    // Facing south, the right hand points west (-X).
+    let right = [-yaw.cos() as f64, -yaw.sin() as f64];
+    let flat = (d[0] * d[0] + d[2] * d[2]).sqrt();
+    let pan = if flat < 1e-6 { 0.0 } else { ((d[0] * right[0] + d[2] * right[1]) / flat) as f32 };
+    // A source straight ahead sounds as loud as one heard without panning.
+    let angle = (pan.clamp(-1.0, 1.0) + 1.0) * std::f32::consts::FRAC_PI_4;
+    let norm = std::f32::consts::SQRT_2;
+    Some([gain * angle.cos() * norm, gain * angle.sin() * norm])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn frame(v: f32) -> Frame {
+        Frame { pcm: vec![v; FRAME], gain: [1.0, 1.0] }
+    }
+
+    #[test]
+    fn waits_for_the_buffer_then_plays() {
+        let mut m = Mixer::default();
+        m.push(1, frame(0.5));
+        assert_eq!(m.sample(48_000), [0.0, 0.0]);
+        for _ in 0..FRAME - 1 {
+            m.sample(48_000);
+        }
+        m.push(1, frame(0.5));
+        m.push(1, frame(0.5));
+        assert_eq!(m.sample(48_000), [0.5, 0.5]);
+    }
+
+    #[test]
+    fn an_ended_voice_plays_out_and_goes() {
+        let mut m = Mixer::default();
+        m.push(1, frame(0.25));
+        m.end(1);
+        assert_eq!(m.sample(48_000), [0.25, 0.25]);
+        assert_eq!(m.voices(), 0);
+    }
+
+    #[test]
+    fn distance_fades_linearly_and_pans_by_side() {
+        let l = Listener { eye: [0.0, 64.0, 0.0], yaw: 0.0 };
+        let ahead = spatial(&l, [0.0, 64.0, 24.0], 48.0).unwrap();
+        assert!((ahead[0] - 0.5).abs() < 1e-4 && (ahead[1] - 0.5).abs() < 1e-4);
+        // Facing south, west (-X) is on the right.
+        let west = spatial(&l, [-10.0, 64.0, 0.0], 48.0).unwrap();
+        assert!(west[1] > 0.9 && west[0] < 1e-3);
+        assert!(spatial(&l, [0.0, 64.0, 60.0], 48.0).is_none());
+        let close = spatial(&l, [0.0, 64.0, 0.0], 48.0).unwrap();
+        assert!((close[0] - 1.0).abs() < 1e-4);
+    }
+
+    #[test]
+    fn resamples_to_48k() {
+        let mut r = Resampler::new(44_100);
+        let mut out = Vec::new();
+        for _ in 0..44_100 {
+            r.push(0.1, &mut out);
+        }
+        assert!((out.len() as i64 - 48_000).abs() <= 2, "{}", out.len());
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/net.rs b/native-mods/voicechat/mixins/voicechat/engine/src/net.rs
new file mode 100644
index 0000000..019c976
--- /dev/null
+++ b/native-mods/voicechat/mixins/voicechat/engine/src/net.rs
@@ -0,0 +1,387 @@
+//! The voice connection: a UDP socket to the server's voice port, as
+//! `ClientVoicechatConnection` runs it (authenticate, then check the
+//! connection, then keep it alive), and the mic thread that sends what the
+//! player says.
+use crate::audio::MicQueue;
+use crate::mix::{Frame, Listener, Mixer, spatial};
+use crate::opus::{Decoder, Encoder, FRAME};
+use crate::proto::{In, Link, Out, Secret, Sound, SoundKind};
+use std::collections::HashMap;
+use std::net::{SocketAddr, ToSocketAddrs, UdpSocket};
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread::JoinHandle;
+use std::time::{Duration, Instant};
+
+/// Where a server address leads (its SRV record): the game's own resolver.
+pub type Redirect = fn(&str, u16) -> (String, u16);
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Mode {
+    #[default]
+    PushToTalk,
+    Voice,
+}
+
+/// What the player chose, read by the threads.
+#[derive(Clone, Debug)]
+pub struct Controls {
+    pub mode: Mode,
+    pub ptt: bool,
+    pub whisper: bool,
+    pub muted: bool,
+    pub disabled: bool,
+    pub threshold_db: f32,
+    pub mic_gain: f32,
+    pub volume: f32,
+    pub player_volumes: HashMap<u128, f32>,
+}
+
+impl Default for Controls {
+    fn default() -> Self {
+        Self {
+            mode: Mode::PushToTalk,
+            ptt: false,
+            whisper: false,
+            muted: false,
+            disabled: false,
+            threshold_db: -50.0,
+            mic_gain: 1.0,
+            volume: 1.0,
+            player_volumes: HashMap::new(),
+        }
+    }
+}
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub enum Status {
+    #[default]
+    Idle,
+    Connecting,
+    Connected,
+    Failed(String),
+}
+
+/// What the game thread and the voice threads share.
+#[derive(Default)]
+pub struct Shared {
+    pub listener: Mutex<Listener>,
+    /// Players' eye positions by UUID, this tick.
+    pub players: Mutex<HashMap<u128, [f64; 3]>>,
+    /// Who was heard last and when, and whether whispering.
+    pub talking: Mutex<HashMap<u128, (Instant, bool)>>,
+    pub controls: Mutex<Controls>,
+    pub status: Mutex<Status>,
+    pub mic_error: Mutex<Option<String>>,
+    /// The microphone's last peak, dB as f32 bits.
+    pub mic_level: AtomicU32,
+    pub transmitting: AtomicBool,
+}
+
+impl Shared {
+    pub fn level(&self) -> f32 {
+        f32::from_bits(self.mic_level.load(Ordering::Relaxed))
+    }
+    fn set_status(&self, s: Status) {
+        *self.status.lock().unwrap() = s;
+    }
+}
+
+pub struct Conn {
+    stop: Arc<AtomicBool>,
+    thread: Option<JoinHandle<()>>,
+}
+
+impl Conn {
+    pub fn start(
+        secret: Secret,
+        server: (String, u16),
+        redirect: Redirect,
+        shared: Arc<Shared>,
+        mixer: Arc<Mutex<Mixer>>,
+        mic: Arc<MicQueue>,
+    ) -> Self {
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = stop.clone();
+        shared.set_status(Status::Connecting);
+        let thread = std::thread::Builder::new()
+            .name("voicechat-net".into())
+            .spawn(move || {
+                let result = run(secret, server, redirect, &shared, &mixer, mic, &flag);
+                mixer.lock().unwrap().clear();
+                shared.transmitting.store(false, Ordering::Relaxed);
+                shared.set_status(match result {
+                    Ok(()) => Status::Idle,
+                    Err(e) => Status::Failed(e),
+                });
+            })
+            .ok();
+        Self { stop, thread }
+    }
+}
+
+impl Drop for Conn {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Relaxed);
+        if let Some(t) = self.thread.take() {
+            let _ = t.join();
+        }
+    }
+}
+
+fn resolve(host: &str, port: u16) -> Result<SocketAddr, String> {
+    let addrs: Vec<SocketAddr> = (host, port)
+        .to_socket_addrs()
+        .map_err(|e| format!("unknown voice host {host}: {e}"))?
+        .collect();
+    addrs
+        .iter()
+        .find(|a| a.is_ipv4())
+        .or(addrs.first())
+        .copied()
+        .ok_or_else(|| format!("unknown voice host {host}"))
+}
+
+fn run(
+    secret: Secret,
+    (server_host, server_port): (String, u16),
+    redirect: Redirect,
+    shared: &Arc<Shared>,
+    mixer: &Arc<Mutex<Mixer>>,
+    mic: Arc<MicQueue>,
+    stop: &Arc<AtomicBool>,
+) -> Result<(), String> {
+    // The game connected to the SRV target, if any: so does the voice.
+    let (game_host, _) = redirect(&server_host, server_port);
+    let (host, port) = secret.voice_address(&game_host);
+    let addr = resolve(&host, port)?;
+    let socket = UdpSocket::bind(if addr.is_ipv4() { "0.0.0.0:0" } else { "[::]:0" })
+        .map_err(|e| format!("no UDP socket: {e}"))?;
+    socket.connect(addr).map_err(|e| format!("voice server {addr}: {e}"))?;
+    socket.set_read_timeout(Some(Duration::from_millis(50))).map_err(|e| e.to_string())?;
+    let keep_alive = Duration::from_millis(u64::from(secret.keep_alive) * 10);
+    let own = secret.player;
+    let link = Arc::new(Link::new(secret));
+    let connected = Arc::new(AtomicBool::new(false));
+
+    // The mic thread stops with this one, whatever ends it.
+    let quit = Arc::new(AtomicBool::new(false));
+    let mic_thread = {
+        let (socket, link, shared, connected, quit) =
+            (socket.try_clone().map_err(|e| e.to_string())?, link.clone(), shared.clone(), connected.clone(), quit.clone());
+        std::thread::Builder::new()
+            .name("voicechat-mic".into())
+            .spawn(move || mic_loop(&socket, &link, &shared, &mic, &quit, &connected))
+            .ok()
+    };
+
+    let send = |p: &Out| {
+        let _ = socket.send(&link.write(p));
+    };
+    let mut authenticated = false;
+    let mut last_try: Option<Instant> = None;
+    let mut last_keep_alive = Instant::now();
+    let mut channels: HashMap<u128, Channel> = HashMap::new();
+    let mut buf = vec![0u8; 4096];
+    let result = loop {
+        if stop.load(Ordering::Relaxed) {
+            break Ok(());
+        }
+        let now = Instant::now();
+        if !connected.load(Ordering::Relaxed) {
+            if last_try.is_none_or(|t| now - t >= Duration::from_secs(1)) {
+                last_try = Some(now);
+                send(if authenticated { &Out::ConnectionCheck } else { &Out::Authenticate });
+            }
+        } else if now - last_keep_alive > keep_alive {
+            break Err("the voice server stopped answering".into());
+        }
+        let n = match socket.recv(&mut buf) {
+            Ok(n) => n,
+            // Timeouts, and ICMP's "unreachable" until the server is up.
+            Err(_) => continue,
+        };
+        let Ok(Some(packet)) = link.read(&buf[..n]) else { continue };
+        match packet {
+            In::AuthenticateAck { nonce } => {
+                if !authenticated {
+                    authenticated = true;
+                    *link.nonce.lock().unwrap() = nonce;
+                    last_try = None;
+                }
+            }
+            In::ConnectionCheckAck => {
+                if authenticated && !connected.swap(true, Ordering::Relaxed) {
+                    shared.set_status(Status::Connected);
+                    last_keep_alive = now;
+                }
+            }
+            In::KeepAlive => {
+                last_keep_alive = now;
+                send(&Out::KeepAlive);
+            }
+            In::Ping { id, timestamp } => send(&Out::Ping { id, timestamp }),
+            In::Sound(sound) => {
+                if !shared.controls.lock().unwrap().disabled {
+                    play(sound, own, shared, mixer, &mut channels);
+                }
+            }
+        }
+        channels.retain(|_, c| now - c.used < Duration::from_secs(30));
+    };
+    connected.store(false, Ordering::Relaxed);
+    quit.store(true, Ordering::Relaxed);
+    if let Some(t) = mic_thread {
+        let _ = t.join();
+    }
+    result
+}
+
+struct Channel {
+    decoder: Decoder,
+    last: i64,
+    used: Instant,
+}
+
+/// `AudioChannel.run` and `writeToSpeaker`: decode in order, conceal what
+/// was lost, and place the voice where its sender is.
+fn play(s: Sound, own: u128, shared: &Shared, mixer: &Mutex<Mixer>, channels: &mut HashMap<u128, Channel>) {
+    let now = Instant::now();
+    let ch = match channels.entry(s.channel) {
+        std::collections::hash_map::Entry::Occupied(e) => e.into_mut(),
+        std::collections::hash_map::Entry::Vacant(e) => match Decoder::new() {
+            Ok(decoder) => e.insert(Channel { decoder, last: -1, used: now }),
+            Err(_) => return,
+        },
+    };
+    ch.used = now;
+    if s.data.is_empty() {
+        // The sender stopped talking.
+        ch.last = -1;
+        ch.decoder.reset();
+        mixer.lock().unwrap().end(s.channel);
+        shared.talking.lock().unwrap().remove(&s.sender);
+        return;
+    }
+    let mut frames = Vec::new();
+    if s.sequence < 0 {
+        // A plugin's raw 16 bit little-endian PCM.
+        let pcm: Vec<i16> = s.data.chunks_exact(2).map(|b| i16::from_le_bytes([b[0], b[1]])).collect();
+        frames.extend(pcm.chunks(FRAME).map(|c| {
+            let mut f = c.to_vec();
+            f.resize(FRAME, 0);
+            f
+        }));
+    } else {
+        if ch.last >= 0 && s.sequence <= ch.last {
+            return;
+        }
+        let mut lost = if ch.last >= 0 { s.sequence - ch.last - 1 } else { 0 };
+        if lost > 5 {
+            ch.decoder.reset();
+            lost = 0;
+        }
+        for i in 0..lost {
+            frames.push(if i == lost - 1 {
+                ch.decoder.decode(Some(&s.data), true)
+            } else {
+                ch.decoder.decode(None, false)
+            });
+        }
+        frames.push(ch.decoder.decode(Some(&s.data), false));
+        ch.last = s.sequence;
+    }
+
+    let (volume, listener) = {
+        let c = shared.controls.lock().unwrap();
+        let v = c.volume * c.player_volumes.get(&s.sender).copied().unwrap_or(1.0);
+        (v, *shared.listener.lock().unwrap())
+    };
+    let gain = match s.kind {
+        SoundKind::Group => Some([1.0, 1.0]),
+        SoundKind::Entity { .. } if s.sender == own => Some([1.0, 1.0]),
+        SoundKind::Entity { distance, .. } => {
+            let at = shared.players.lock().unwrap().get(&s.sender).copied();
+            at.and_then(|at| spatial(&listener, at, distance))
+        }
+        SoundKind::Location { at, distance } => spatial(&listener, at, distance),
+    };
+    let Some(gain) = gain else { return };
+    let gain = gain.map(|g| g * volume);
+    let mut m = mixer.lock().unwrap();
+    for f in frames {
+        m.push(s.channel, Frame { pcm: f.iter().map(|&v| f32::from(v) / 32768.0).collect(), gain });
+    }
+    drop(m);
+    if gain.iter().any(|g| *g > 0.0) {
+        let whispering = matches!(s.kind, SoundKind::Entity { whispering: true, .. });
+        shared.talking.lock().unwrap().insert(s.sender, (now, whispering));
+    }
+}
+
+/// `MicThread`: each 20 ms frame of the microphone, sent while the push to
+/// talk key is held or the voice is loud enough, and a little after.
+fn mic_loop(socket: &UdpSocket, link: &Link, shared: &Shared, mic: &MicQueue, stop: &AtomicBool, connected: &AtomicBool) {
+    let mut encoder = match Encoder::new(link.secret.opus_application(), link.secret.mtu) {
+        Ok(e) => e,
+        Err(e) => {
+            *shared.mic_error.lock().unwrap() = Some(e);
+            return;
+        }
+    };
+    let mut sequence: i64 = 0;
+    let mut sending = false;
+    let mut hold = 0u32;
+    let send = |p: &Out| {
+        let _ = socket.send(&link.write(p));
+    };
+    while !stop.load(Ordering::Relaxed) {
+        let frame: Vec<f32> = {
+            let mut q = mic.samples.lock().unwrap();
+            if q.len() < FRAME {
+                q = mic.ready.wait_timeout(q, Duration::from_millis(100)).unwrap().0;
+            }
+            if q.len() < FRAME {
+                continue;
+            }
+            q.drain(..FRAME).collect()
+        };
+        let c = shared.controls.lock().unwrap().clone();
+        let mut pcm = [0i16; FRAME];
+        let mut peak = 0f32;
+        for (o, s) in pcm.iter_mut().zip(&frame) {
+            let v = (s * c.mic_gain).clamp(-1.0, 1.0);
+            peak = peak.max(v.abs());
+            *o = (v * 32767.0) as i16;
+        }
+        let db = if peak > 0.0 { (20.0 * peak.log10()).max(-127.0) } else { -127.0 };
+        shared.mic_level.store(db.to_bits(), Ordering::Relaxed);
+
+        let can = connected.load(Ordering::Relaxed) && !c.muted && !c.disabled;
+        let mut talk = can
+            && match c.mode {
+                Mode::PushToTalk => c.ptt || c.whisper,
+                Mode::Voice => db > c.threshold_db,
+            };
+        if talk {
+            hold = if c.mode == Mode::PushToTalk { 5 } else { 25 };
+        } else if can && hold > 0 {
+            hold -= 1;
+            talk = true;
+        }
+        if talk {
+            if let Ok(data) = encoder.encode(&pcm) {
+                send(&Out::Mic { data, sequence, whispering: c.whisper });
+                sequence += 1;
+                sending = true;
+            }
+        } else if sending {
+            send(&Out::Mic { data: Vec::new(), sequence, whispering: false });
+            sequence += 1;
+            encoder.reset();
+            sending = false;
+            hold = 0;
+        }
+        shared.transmitting.store(sending, Ordering::Relaxed);
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/opus.rs b/native-mods/voicechat/mixins/voicechat/engine/src/opus.rs
new file mode 100644
index 0000000..36ccc70
--- /dev/null
+++ b/native-mods/voicechat/mixins/voicechat/engine/src/opus.rs
@@ -0,0 +1,200 @@
+//! Opus from the system's libopus, loaded when voice chat first starts: 48 kHz
+//! mono, 20 ms frames, as Simple Voice Chat codes them.
+use libloading::Library;
+use std::ffi::{c_int, c_void};
+use std::sync::OnceLock;
+
+pub const SAMPLE_RATE: u32 = 48_000;
+pub const FRAME: usize = 960;
+
+pub const APPLICATION_VOIP: i32 = 2048;
+pub const APPLICATION_AUDIO: i32 = 2049;
+pub const APPLICATION_RESTRICTED_LOWDELAY: i32 = 2051;
+const OPUS_RESET_STATE: c_int = 4028;
+
+type EncoderCreate = unsafe extern "C" fn(i32, c_int, c_int, *mut c_int) -> *mut c_void;
+type Encode = unsafe extern "C" fn(*mut c_void, *const i16, c_int, *mut u8, i32) -> i32;
+type DecoderCreate = unsafe extern "C" fn(i32, c_int, *mut c_int) -> *mut c_void;
+type Decode = unsafe extern "C" fn(*mut c_void, *const u8, i32, *mut i16, c_int, c_int) -> c_int;
+type Destroy = unsafe extern "C" fn(*mut c_void);
+type Ctl = unsafe extern "C" fn(*mut c_void, c_int, ...) -> c_int;
+
+struct Api {
+    _lib: Library,
+    encoder_create: EncoderCreate,
+    encode: Encode,
+    encoder_destroy: Destroy,
+    encoder_ctl: Ctl,
+    decoder_create: DecoderCreate,
+    decode: Decode,
+    decoder_destroy: Destroy,
+    decoder_ctl: Ctl,
+}
+
+const NAMES: &[&str] = &[
+    "libopus.so.0",
+    "libopus.so",
+    "libopus.0.dylib",
+    "libopus.dylib",
+    "/opt/homebrew/lib/libopus.0.dylib",
+    "/usr/local/lib/libopus.0.dylib",
+    "opus.dll",
+    "libopus-0.dll",
+];
+
+fn api() -> Result<&'static Api, String> {
+    static API: OnceLock<Result<Api, String>> = OnceLock::new();
+    API.get_or_init(load).as_ref().map_err(Clone::clone)
+}
+
+fn load() -> Result<Api, String> {
+    let mut errors = Vec::new();
+    for name in NAMES {
+        // SAFETY: libopus runs no code of its own when it loads.
+        match unsafe { Library::new(name) } {
+            Ok(lib) => return unsafe { symbols(lib) }.map_err(|e| format!("{name}: {e}")),
+            Err(e) => errors.push(e.to_string()),
+        }
+    }
+    Err(format!("libopus not found (install the opus package): {}", errors.join("; ")))
+}
+
+unsafe fn symbols(lib: Library) -> Result<Api, libloading::Error> {
+    unsafe {
+        Ok(Api {
+            encoder_create: *lib.get(b"opus_encoder_create\0")?,
+            encode: *lib.get(b"opus_encode\0")?,
+            encoder_destroy: *lib.get(b"opus_encoder_destroy\0")?,
+            encoder_ctl: *lib.get(b"opus_encoder_ctl\0")?,
+            decoder_create: *lib.get(b"opus_decoder_create\0")?,
+            decode: *lib.get(b"opus_decode\0")?,
+            decoder_destroy: *lib.get(b"opus_decoder_destroy\0")?,
+            decoder_ctl: *lib.get(b"opus_decoder_ctl\0")?,
+            _lib: lib,
+        })
+    }
+}
+
+/// Whether libopus loads, and why not.
+pub fn check() -> Result<(), String> {
+    api().map(|_| ())
+}
+
+pub struct Encoder {
+    api: &'static Api,
+    raw: *mut c_void,
+    max_bytes: usize,
+}
+
+// SAFETY: an encoder is used by one thread at a time.
+unsafe impl Send for Encoder {}
+
+impl Encoder {
+    /// `max_bytes`: the server's MTU, Opus's 1275 at most.
+    pub fn new(application: i32, max_bytes: usize) -> Result<Self, String> {
+        let api = api()?;
+        let mut err = 0;
+        let raw = unsafe { (api.encoder_create)(SAMPLE_RATE as i32, 1, application, &mut err) };
+        if raw.is_null() || err != 0 {
+            return Err(format!("opus_encoder_create failed ({err})"));
+        }
+        Ok(Self { api, raw, max_bytes: max_bytes.clamp(64, 1275) })
+    }
+
+    pub fn encode(&mut self, frame: &[i16; FRAME]) -> Result<Vec<u8>, String> {
+        let mut out = vec![0u8; self.max_bytes];
+        let n = unsafe {
+            (self.api.encode)(self.raw, frame.as_ptr(), FRAME as c_int, out.as_mut_ptr(), out.len() as i32)
+        };
+        if n < 0 {
+            return Err(format!("opus_encode failed ({n})"));
+        }
+        out.truncate(n as usize);
+        Ok(out)
+    }
+
+    pub fn reset(&mut self) {
+        unsafe { (self.api.encoder_ctl)(self.raw, OPUS_RESET_STATE) };
+    }
+}
+
+impl Drop for Encoder {
+    fn drop(&mut self) {
+        unsafe { (self.api.encoder_destroy)(self.raw) };
+    }
+}
+
+pub struct Decoder {
+    api: &'static Api,
+    raw: *mut c_void,
+}
+
+// SAFETY: a decoder is used by one thread at a time.
+unsafe impl Send for Decoder {}
+
+impl Decoder {
+    pub fn new() -> Result<Self, String> {
+        let api = api()?;
+        let mut err = 0;
+        let raw = unsafe { (api.decoder_create)(SAMPLE_RATE as i32, 1, &mut err) };
+        if raw.is_null() || err != 0 {
+            return Err(format!("opus_decoder_create failed ({err})"));
+        }
+        Ok(Self { api, raw })
+    }
+
+    /// A frame from `packet`; None conceals a lost one, and `fec` rebuilds
+    /// the lost frame before `packet` from the redundancy in it.
+    pub fn decode(&mut self, packet: Option<&[u8]>, fec: bool) -> Vec<i16> {
+        let mut pcm = vec![0i16; FRAME];
+        let (ptr, len) = packet.map_or((std::ptr::null(), 0), |p| (p.as_ptr(), p.len() as i32));
+        let n = unsafe {
+            (self.api.decode)(self.raw, ptr, len, pcm.as_mut_ptr(), FRAME as c_int, fec as c_int)
+        };
+        if n < 0 {
+            pcm.fill(0);
+        } else {
+            pcm.truncate(n as usize);
+            pcm.resize(FRAME, 0);
+        }
+        pcm
+    }
+
+    pub fn reset(&mut self) {
+        unsafe { (self.api.decoder_ctl)(self.raw, OPUS_RESET_STATE) };
+    }
+}
+
+impl Drop for Decoder {
+    fn drop(&mut self) {
+        unsafe { (self.api.decoder_destroy)(self.raw) };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_tone_survives_encoding() {
+        if check().is_err() {
+            eprintln!("no libopus here: skipped");
+            return;
+        }
+        let mut enc = Encoder::new(APPLICATION_VOIP, 1275).unwrap();
+        let mut dec = Decoder::new().unwrap();
+        let mut last = Vec::new();
+        for f in 0..10 {
+            let frame: [i16; FRAME] = std::array::from_fn(|i| {
+                let t = (f * FRAME + i) as f32 / SAMPLE_RATE as f32;
+                ((t * 440.0 * std::f32::consts::TAU).sin() * 8000.0) as i16
+            });
+            let packet = enc.encode(&frame).unwrap();
+            assert!(!packet.is_empty() && packet.len() <= 1275);
+            last = dec.decode(Some(&packet), false);
+        }
+        let peak = last.iter().map(|s| s.unsigned_abs()).max().unwrap();
+        assert!(peak > 4000, "peak {peak}");
+        assert_eq!(dec.decode(None, false).len(), FRAME);
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/proto.rs b/native-mods/voicechat/mixins/voicechat/engine/src/proto.rs
new file mode 100644
index 0000000..58e3e78
--- /dev/null
+++ b/native-mods/voicechat/mixins/voicechat/engine/src/proto.rs
@@ -0,0 +1,550 @@
+//! Simple Voice Chat's packets, as its client sends and reads them.
+//!
+//! Two versions are spoken: compatibility version 20 (2.6.x, the releases
+//! for 26.3) and 21 (2.7, which adds a random connection id, nonces in the
+//! connection check and muted states). The server answers only the version it
+//! has, so the client asks with both.
+use crate::buf::{Reader, Result, Writer};
+use crate::crypt::Crypt;
+
+pub const COMPAT_26: i32 = 20;
+pub const COMPAT_27: i32 = 21;
+
+pub const MAGIC: u8 = 0xFF;
+pub const MAX_PACKET: usize = 2048;
+pub const MAX_OPUS: usize = 1275;
+pub const MAX_GROUP_NAME: usize = 24;
+pub const MAX_GROUP_PASSWORD: usize = 256;
+
+/// The channels the client registers (`minecraft:register`) so that every
+/// server platform sends it the voice chat's packets.
+pub const CHANNELS: [&str; 15] = [
+    "voicechat:request_secret",
+    "voicechat:secret",
+    "voicechat:state",
+    "voicechat:states",
+    "voicechat:remove_state",
+    "voicechat:update_state",
+    "voicechat:client_state",
+    "voicechat:add_group",
+    "voicechat:remove_group",
+    "voicechat:set_group",
+    "voicechat:joined_group",
+    "voicechat:leave_group",
+    "voicechat:create_group",
+    "voicechat:add_category",
+    "voicechat:remove_category",
+];
+
+pub fn register_payload() -> Vec<u8> {
+    CHANNELS.join("\0").into_bytes()
+}
+
+pub fn request_secret(compat: i32) -> (&'static str, Vec<u8>) {
+    ("voicechat:request_secret", Writer::new().i32(compat).finish())
+}
+
+/// `UpdateStatePacket`: 2.6 sends only whether voice chat is off.
+pub fn update_state(compat: i32, muted: bool, disabled: bool) -> (&'static str, Vec<u8>) {
+    if compat >= COMPAT_27 {
+        ("voicechat:client_state", Writer::new().bool(muted).bool(disabled).finish())
+    } else {
+        ("voicechat:update_state", Writer::new().bool(disabled).finish())
+    }
+}
+
+pub fn join_group(group: u128, password: Option<&str>) -> (&'static str, Vec<u8>) {
+    let mut w = Writer::new();
+    w.uuid(group).bool(password.is_some());
+    if let Some(p) = password {
+        w.utf(&clip(p, MAX_GROUP_PASSWORD));
+    }
+    ("voicechat:set_group", w.finish())
+}
+
+/// Group types: 0 normal, 1 open, 2 isolated.
+pub fn create_group(name: &str, password: Option<&str>, kind: i16) -> (&'static str, Vec<u8>) {
+    let mut w = Writer::new();
+    w.utf(&clip(name, MAX_GROUP_NAME)).bool(password.is_some());
+    if let Some(p) = password {
+        w.utf(&clip(p, MAX_GROUP_NAME));
+    }
+    w.i16(kind);
+    ("voicechat:create_group", w.finish())
+}
+
+pub fn leave_group() -> (&'static str, Vec<u8>) {
+    ("voicechat:leave_group", Vec::new())
+}
+
+fn clip(s: &str, max: usize) -> String {
+    s.chars().take(max).collect()
+}
+
+/// `SecretPacket` and the `InitializationData` it makes.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Secret {
+    pub compat: i32,
+    pub key: [u8; 16],
+    /// 2.7's connection id; 2.6 names the connection by the player's UUID.
+    pub connection_id: Option<u128>,
+    pub port: u16,
+    pub player: u128,
+    pub codec: u8,
+    pub mtu: usize,
+    pub distance: f64,
+    pub keep_alive: u32,
+    pub groups: bool,
+    pub voice_host: String,
+    pub allow_recording: bool,
+}
+
+impl Secret {
+    /// The secret as either version writes it: the one that reads the whole
+    /// payload into sensible values.
+    pub fn parse(data: &[u8]) -> Result<Self> {
+        Self::parse_as(data, COMPAT_27).or_else(|_| Self::parse_as(data, COMPAT_26))
+    }
+
+    pub fn parse_as(data: &[u8], compat: i32) -> Result<Self> {
+        let mut r = Reader::new(data);
+        let key: [u8; 16] = r.bytes(16)?.try_into().expect("16 bytes");
+        let connection_id = if compat >= COMPAT_27 { Some(r.uuid()?) } else { None };
+        let port = r.i32()?;
+        let player = r.uuid()?;
+        let codec = r.u8()?;
+        let mtu = r.i32()?;
+        let distance = r.f64()?;
+        let keep_alive = r.i32()?;
+        let groups = r.bool()?;
+        let voice_host = r.utf(32767)?;
+        let allow_recording = r.u8()?;
+        if r.remaining() != 0 {
+            return Err("bytes left over");
+        }
+        if !(0..=65535).contains(&port) || codec > 2 || allow_recording > 1 || keep_alive <= 0 {
+            return Err("not a secret of this version");
+        }
+        if !distance.is_finite() || distance <= 0.0 {
+            return Err("not a secret of this version");
+        }
+        Ok(Self {
+            compat,
+            key,
+            connection_id,
+            port: port as u16,
+            player,
+            codec,
+            mtu: mtu.clamp(512, 2048) as usize,
+            distance,
+            keep_alive: keep_alive as u32,
+            groups,
+            voice_host,
+            allow_recording: allow_recording == 1,
+        })
+    }
+
+    /// The UUID every UDP packet starts with.
+    pub fn header_id(&self) -> u128 {
+        self.connection_id.unwrap_or(self.player)
+    }
+
+    /// Opus's application for the server's codec setting.
+    pub fn opus_application(&self) -> i32 {
+        match self.codec {
+            1 => crate::opus::APPLICATION_AUDIO,
+            2 => crate::opus::APPLICATION_RESTRICTED_LOWDELAY,
+            _ => crate::opus::APPLICATION_VOIP,
+        }
+    }
+
+    /// `InitializationData.parseAddress`: an empty voice host is the game
+    /// server's address with the secret's port, a number is only another
+    /// port, anything else a host and maybe a port.
+    pub fn voice_address(&self, server_host: &str) -> (String, u16) {
+        let host = self.voice_host.trim();
+        if host.is_empty() {
+            return (server_host.to_owned(), self.port);
+        }
+        if let Ok(port) = host.parse::<i64>() {
+            return match u16::try_from(port) {
+                Ok(p) if p > 0 => (server_host.to_owned(), p),
+                _ => (server_host.to_owned(), self.port),
+            };
+        }
+        match split_host_port(host) {
+            Some((h, Some(p))) => (h, p),
+            Some((h, None)) => (h, self.port),
+            None => (server_host.to_owned(), self.port),
+        }
+    }
+}
+
+/// `host`, `host:port`, `[v6]` or `[v6]:port`, as a URI's authority.
+pub fn split_host_port(s: &str) -> Option<(String, Option<u16>)> {
+    let s = s.trim();
+    if s.is_empty() {
+        return None;
+    }
+    if let Some(rest) = s.strip_prefix('[') {
+        let (host, after) = rest.split_once(']')?;
+        let port = after.strip_prefix(':').and_then(|p| p.parse().ok());
+        return Some((host.to_owned(), port));
+    }
+    match s.rsplit_once(':') {
+        // A bare IPv6 address has more than one colon and no port.
+        Some((h, p)) if !h.contains(':') => Some((h.to_owned(), p.parse().ok())),
+        _ => Some((s.to_owned(), None)),
+    }
+}
+
+/// `PlayerState`: who has voice chat, who turned it off, and their group.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct PlayerState {
+    pub uuid: u128,
+    pub name: String,
+    pub muted: bool,
+    pub disabled: bool,
+    pub disconnected: bool,
+    pub group: Option<u128>,
+}
+
+impl PlayerState {
+    pub fn read(r: &mut Reader, compat: i32) -> Result<Self> {
+        if compat >= COMPAT_27 {
+            let flags = r.u8()?;
+            let uuid = r.uuid()?;
+            let name = r.utf(256)?;
+            let group = if flags & 0b10_0000 != 0 { Some(r.uuid()?) } else { None };
+            Ok(Self {
+                uuid,
+                name,
+                muted: flags & 0b11 != 0,
+                disabled: flags & 0b1100 != 0,
+                disconnected: flags & 0b1_0000 != 0,
+                group,
+            })
+        } else {
+            let disabled = r.bool()?;
+            let disconnected = r.bool()?;
+            let uuid = r.uuid()?;
+            let name = r.utf(32767)?;
+            let group = if r.bool()? { Some(r.uuid()?) } else { None };
+            Ok(Self { uuid, name, muted: false, disabled, disconnected, group })
+        }
+    }
+
+    pub fn parse(data: &[u8], compat: i32) -> Result<Self> {
+        let mut r = Reader::new(data);
+        Self::read(&mut r, compat)
+    }
+
+    pub fn parse_all(data: &[u8], compat: i32) -> Result<Vec<Self>> {
+        let mut r = Reader::new(data);
+        let count = r.i32()?;
+        if count < 0 {
+            return Err("negative count");
+        }
+        (0..count).map(|_| Self::read(&mut r, compat)).collect()
+    }
+}
+
+/// `ClientGroup`.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Group {
+    pub id: u128,
+    pub name: String,
+    pub has_password: bool,
+    pub persistent: bool,
+    pub hidden: bool,
+    pub kind: i16,
+}
+
+impl Group {
+    pub fn parse(data: &[u8]) -> Result<Self> {
+        let mut r = Reader::new(data);
+        Ok(Self {
+            id: r.uuid()?,
+            name: r.utf(512)?,
+            has_password: r.bool()?,
+            persistent: r.bool()?,
+            hidden: r.bool()?,
+            kind: r.i16()?,
+        })
+    }
+}
+
+/// `JoinedGroupPacket`: the group, or none, and whether the password was wrong.
+pub fn parse_joined_group(data: &[u8]) -> Result<(Option<u128>, bool)> {
+    let mut r = Reader::new(data);
+    let group = if r.bool()? { Some(r.uuid()?) } else { None };
+    Ok((group, r.bool()?))
+}
+
+pub fn parse_uuid(data: &[u8]) -> Result<u128> {
+    Reader::new(data).uuid()
+}
+
+/// What the client sends over UDP.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Out {
+    Mic { data: Vec<u8>, sequence: i64, whispering: bool },
+    Authenticate,
+    ConnectionCheck,
+    KeepAlive,
+    Ping { id: u128, timestamp: i64 },
+}
+
+/// What the server sends over UDP.
+#[derive(Clone, Debug, PartialEq)]
+pub enum In {
+    Sound(Sound),
+    AuthenticateAck { nonce: Option<[u8; 16]> },
+    ConnectionCheckAck,
+    KeepAlive,
+    Ping { id: u128, timestamp: i64 },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum SoundKind {
+    /// From a player or entity, heard where it is (`PlayerSoundPacket`).
+    Entity { distance: f32, whispering: bool },
+    /// The group's, heard as if beside the player (`GroupSoundPacket`).
+    Group,
+    /// From a place (`LocationSoundPacket`).
+    Location { at: [f64; 3], distance: f32 },
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub struct Sound {
+    pub channel: u128,
+    pub sender: u128,
+    pub data: Vec<u8>,
+    /// Negative: raw 16 bit PCM from a server plugin, not Opus.
+    pub sequence: i64,
+    pub kind: SoundKind,
+    pub category: Option<String>,
+}
+
+/// The connection's secret and the version both ends speak.
+pub struct Link {
+    pub crypt: Crypt,
+    pub secret: Secret,
+    /// The server's nonce from the authentication ack (2.7).
+    pub nonce: std::sync::Mutex<Option<[u8; 16]>>,
+}
+
+impl Link {
+    pub fn new(secret: Secret) -> Self {
+        Self { crypt: Crypt::new(&secret.key), secret, nonce: Default::default() }
+    }
+
+    /// `ClientNetworkMessage.writeClient`.
+    pub fn write(&self, packet: &Out) -> Vec<u8> {
+        let mut body = Writer::new();
+        match packet {
+            Out::Mic { data, sequence, whispering } => {
+                body.u8(0x1).byte_array(data).i64(*sequence).bool(*whispering);
+            }
+            Out::Authenticate => {
+                body.u8(0x5);
+                if self.secret.compat < COMPAT_27 {
+                    body.uuid(self.secret.player).raw(&self.secret.key);
+                }
+            }
+            Out::Ping { id, timestamp } => {
+                body.u8(0x7).uuid(*id).i64(*timestamp);
+            }
+            Out::KeepAlive => {
+                body.u8(0x8);
+            }
+            Out::ConnectionCheck => {
+                body.u8(0x9);
+                if self.secret.compat >= COMPAT_27 {
+                    body.raw(&self.nonce.lock().unwrap().unwrap_or_default());
+                }
+            }
+        }
+        let sealed = self.crypt.encrypt(&body.finish());
+        Writer::new().u8(MAGIC).uuid(self.secret.header_id()).byte_array(&sealed).finish()
+    }
+
+    /// `ClientNetworkMessage.readPacketClient`. Ok(None) for a packet the
+    /// client ignores.
+    pub fn read(&self, datagram: &[u8]) -> Result<Option<In>> {
+        let mut r = Reader::new(datagram);
+        if r.u8()? != MAGIC {
+            return Err("not a voice chat packet");
+        }
+        let sealed = r.byte_array(MAX_PACKET)?;
+        let plain = self.crypt.decrypt(sealed).ok_or("not sealed with this secret")?;
+        read_plain(&plain)
+    }
+}
+
+fn read_plain(plain: &[u8]) -> Result<Option<In>> {
+    let mut r = Reader::new(plain);
+    let packet = match r.u8()? {
+        0x2 => {
+            let channel = r.uuid()?;
+            let sender = r.uuid()?;
+            let data = r.byte_array(MAX_OPUS)?.to_vec();
+            let sequence = r.i64()?;
+            let distance = r.f32()?;
+            let flags = r.u8()?;
+            let category = if flags & 0b10 != 0 { Some(r.utf(16)?) } else { None };
+            In::Sound(Sound {
+                channel,
+                sender,
+                data,
+                sequence,
+                kind: SoundKind::Entity { distance, whispering: flags & 0b1 != 0 },
+                category,
+            })
+        }
+        0x3 => {
+            let channel = r.uuid()?;
+            let sender = r.uuid()?;
+            let data = r.byte_array(MAX_OPUS)?.to_vec();
+            let sequence = r.i64()?;
+            let flags = r.u8()?;
+            let category = if flags & 0b10 != 0 { Some(r.utf(16)?) } else { None };
+            In::Sound(Sound { channel, sender, data, sequence, kind: SoundKind::Group, category })
+        }
+        0x4 => {
+            let channel = r.uuid()?;
+            let sender = r.uuid()?;
+            let at = [r.f64()?, r.f64()?, r.f64()?];
+            let data = r.byte_array(MAX_OPUS)?.to_vec();
+            let sequence = r.i64()?;
+            let distance = r.f32()?;
+            let flags = r.u8()?;
+            let category = if flags & 0b10 != 0 { Some(r.utf(16)?) } else { None };
+            In::Sound(Sound {
+                channel,
+                sender,
+                data,
+                sequence,
+                kind: SoundKind::Location { at, distance },
+                category,
+            })
+        }
+        0x6 => {
+            let nonce = if r.remaining() >= 16 {
+                Some(r.bytes(16)?.try_into().expect("16 bytes"))
+            } else {
+                None
+            };
+            In::AuthenticateAck { nonce }
+        }
+        0x7 => In::Ping { id: r.uuid()?, timestamp: r.i64()? },
+        0x8 => In::KeepAlive,
+        0xA => In::ConnectionCheckAck,
+        _ => return Ok(None),
+    };
+    Ok(Some(packet))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn secret_bytes(compat: i32, voice_host: &str) -> Vec<u8> {
+        let mut w = Writer::new();
+        w.raw(&[9; 16]);
+        if compat >= COMPAT_27 {
+            w.uuid(0xC0FFEE);
+        }
+        w.i32(24454).uuid(0xABCD).u8(0).i32(1275);
+        w.raw(&48f64.to_be_bytes()).i32(1000).bool(true).utf(voice_host).bool(false);
+        w.finish()
+    }
+
+    #[test]
+    fn reads_both_secret_versions() {
+        let old = Secret::parse(&secret_bytes(COMPAT_26, "")).unwrap();
+        assert_eq!((old.compat, old.connection_id, old.port, old.player), (20, None, 24454, 0xABCD));
+        assert_eq!(old.header_id(), 0xABCD);
+        let new = Secret::parse(&secret_bytes(COMPAT_27, "voice.example.net:5000")).unwrap();
+        assert_eq!((new.compat, new.connection_id), (21, Some(0xC0FFEE)));
+        assert_eq!(new.header_id(), 0xC0FFEE);
+        assert_eq!(new.voice_address("mc.example.net"), ("voice.example.net".into(), 5000));
+        assert_eq!(old.voice_address("1.2.3.4"), ("1.2.3.4".into(), 24454));
+    }
+
+    #[test]
+    fn voice_hosts_parse_as_the_mod_does() {
+        let mut s = Secret::parse(&secret_bytes(COMPAT_26, "")).unwrap();
+        s.voice_host = "25000".into();
+        assert_eq!(s.voice_address("h"), ("h".into(), 25000));
+        s.voice_host = "voice.host".into();
+        assert_eq!(s.voice_address("h"), ("voice.host".into(), 24454));
+        s.voice_host = "[::1]:7".into();
+        assert_eq!(s.voice_address("h"), ("::1".into(), 7));
+    }
+
+    #[test]
+    fn reads_player_states_of_both_versions() {
+        let mut w = Writer::new();
+        w.i32(1).bool(true).bool(false).uuid(5).utf("Alex").bool(true).uuid(6);
+        let old = PlayerState::parse_all(&w.finish(), COMPAT_26).unwrap();
+        assert_eq!(old[0], PlayerState {
+            uuid: 5,
+            name: "Alex".into(),
+            muted: false,
+            disabled: true,
+            disconnected: false,
+            group: Some(6),
+        });
+        let mut w = Writer::new();
+        w.u8(0b10_0001).uuid(5).utf("Alex").uuid(6);
+        let new = PlayerState::parse(&w.finish(), COMPAT_27).unwrap();
+        assert!(new.muted && !new.disabled && new.group == Some(6));
+    }
+
+    #[test]
+    fn writes_the_authentication_each_version_expects() {
+        let link = Link::new(Secret::parse(&secret_bytes(COMPAT_26, "")).unwrap());
+        let datagram = link.write(&Out::Authenticate);
+        let mut r = Reader::new(&datagram);
+        assert_eq!(r.u8().unwrap(), MAGIC);
+        assert_eq!(r.uuid().unwrap(), 0xABCD);
+        let plain = link.crypt.decrypt(r.byte_array(MAX_PACKET).unwrap()).unwrap();
+        assert_eq!(plain.len(), 1 + 16 + 16);
+        assert_eq!(&plain[17..], &[9; 16]);
+
+        let link = Link::new(Secret::parse(&secret_bytes(COMPAT_27, "")).unwrap());
+        *link.nonce.lock().unwrap() = Some([3; 16]);
+        let datagram = link.write(&Out::ConnectionCheck);
+        let mut r = Reader::new(&datagram);
+        r.u8().unwrap();
+        assert_eq!(r.uuid().unwrap(), 0xC0FFEE);
+        let plain = link.crypt.decrypt(r.byte_array(MAX_PACKET).unwrap()).unwrap();
+        assert_eq!(plain, [&[0x9][..], &[3; 16]].concat());
+    }
+
+    #[test]
+    fn reads_sound_packets_from_the_server() {
+        let link = Link::new(Secret::parse(&secret_bytes(COMPAT_26, "")).unwrap());
+        let mut w = Writer::new();
+        w.u8(0x2).uuid(1).uuid(2).byte_array(&[1, 2, 3]).i64(7);
+        w.raw(&24f32.to_be_bytes()).u8(0b11).utf("music");
+        let sealed = link.crypt.encrypt(&w.finish());
+        let datagram = Writer::new().u8(MAGIC).byte_array(&sealed).finish();
+        let Some(In::Sound(s)) = link.read(&datagram).unwrap() else { panic!() };
+        assert_eq!((s.channel, s.sender, s.sequence), (1, 2, 7));
+        assert_eq!(s.kind, SoundKind::Entity { distance: 24.0, whispering: true });
+        assert_eq!(s.category.as_deref(), Some("music"));
+    }
+
+    #[test]
+    fn group_payloads_match_the_mod() {
+        let (ch, data) = join_group(0x11, Some("pw"));
+        assert_eq!(ch, "voicechat:set_group");
+        assert_eq!(data.len(), 16 + 1 + 1 + 2);
+        let (_, data) = create_group("Friends", None, 1);
+        assert_eq!(data, [&b"\x07Friends"[..], &[0], &[0, 1]].concat());
+        assert_eq!(update_state(COMPAT_26, true, false), ("voicechat:update_state", vec![0]));
+        assert_eq!(update_state(COMPAT_27, true, false), ("voicechat:client_state", vec![1, 0]));
+    }
+}
diff --git a/native-mods/voicechat/mixins/voicechat/engine/src/ui.rs b/native-mods/voicechat/mixins/voicechat/engine/src/ui.rs
