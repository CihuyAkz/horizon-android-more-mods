+/// `key.keyboard.v` → `v`: the character a key types, for single letters
+/// and digits.
+pub fn key_char(key: &str) -> Option<char> {
+    let name = key.strip_prefix("key.keyboard.")?;
+    let mut chars = name.chars();
+    let c = chars.next()?;
+    chars.next().is_none().then_some(c)
