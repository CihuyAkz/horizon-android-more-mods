-        let first = keys.next()?;
-        Some(keys.fold((first.1, first.2, first.1, first.2), |b, k| {
-            (b.0.min(k.1), b.1.min(k.2), b.2.max(k.1), b.3.max(k.2))
-        }))
-    }
