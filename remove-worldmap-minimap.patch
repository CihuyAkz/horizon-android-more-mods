-/// A region file's name without its extension: `r.X.Z` for the surface,
-/// `c.LAYER.X.Z` for a cave layer.
-fn region_name(layer: i32, region: (i32, i32)) -> String {
-    if layer == SURFACE {
-        format!("r.{}.{}", region.0, region.1)
-    } else {
-        format!("c.{layer}.{}.{}", region.0, region.1)
-    }
-}
