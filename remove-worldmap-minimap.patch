-    /// The same turned by `yaw` degrees: the way a player faces is up (the minimap's).
-    #[allow(clippy::too_many_arguments)]
-    fn render_turned(
-        &self,
-        layer: i32,
-        cx: f64,
-        cz: f64,
-        bpp: f32,
-        w: usize,
-        h: usize,
-        light: u8,
-        yaw: f32,
-        img: &mut Vec<u8>,
