-    fn axes(&self) -> ([f64; 2], [f64; 2]) {
-        if !self.rotate {
-            return ([1.0, 0.0], [0.0, -1.0]);
-        }
-        let (s, c) = f64::from(self.yaw).to_radians().sin_cos();
-        ([-c, -s], [-s, c])
-    }
-    /// Where north is on the map's rim, as a unit direction (x right, y down).
-    pub fn north(&self) -> (f32, f32) {
-        let (r, f) = self.axes();
