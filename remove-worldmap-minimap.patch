-        layer: i32,
-        cx: f64,
-        cz: f64,
-        bpp: f32,
-        w: usize,
-        h: usize,
-        light: u8,
-        yaw: f32,
-        img: &mut Vec<u8>,
-    ) {
-        let (sin, cos) = f64::from(yaw).to_radians().sin_cos();
-        // Forward, in the world's x and z; right of it is (-fz, fx).
-        self.render_smooth(layer, cx, cz, bpp, w, h, light, Some((-sin, cos)), img);
-    }
