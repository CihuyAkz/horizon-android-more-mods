-    let settings = Settings::read(game);
-    for (i, (_, label)) in SETTINGS.iter().enumerate() {
-        let name = if ru { ru_text(label).unwrap_or(label) } else { label };
-        let state = match (settings.get(i), ru) {
-            (true, true) => "ВКЛ",
-            (false, true) => "ВЫКЛ",
