-        let taken = jobs.len();
-        if let Ok(mut w) = self.writing.lock() {
-            w.extend(jobs.iter().map(|j| j.0));
-        }
-        let failed = Arc::clone(&self.failed);
-        let writing = Arc::clone(&self.writing);
-        let write = move |jobs: Vec<((i32, i32, i32), PathBuf, PathBuf, Vec<u8>)>| {
