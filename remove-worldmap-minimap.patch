-    let size = MINI_SIZE_NAMES[usize::from(settings.size).min(MINI_SIZE_NAMES.len() - 1)];
-    let word = |text: &str| -> String {
-        if ru { ru_text(text).unwrap_or(text).to_owned() } else { text.to_owned() }
